{
    "keyboard_name": "NINEXpad",
    "manufacturer": "teamOWL",
    "url": "https://github.com/fishpepper/ninex",
    "maintainer": "fishpepper",
    "usb": {
        "vid": "0x1209",
        "pid": "0x4650",
        "device_version": "0.0.1"
    },
    "processor": "RP2040",
    "bootloader": "rp2040",
    "features": {
        "bootmagic": true,
        "mousekey": true,
        "extrakey": true,
        "nkro": true,
        "rgb_matrix": true
    },
    // One switch per GPIO, wired straight to GND (sockets U$* in the
    // schematic). Row 0 is the row nearest the USB connector, column 0 the
    // leftmost one; the wide gap sits between columns 2 and 3.
    "matrix_pins": {
        "direct": [
            ["GP28", "GP29", "GP27", "GP0"],
            ["GP25", "GP26", "GP21", "GP5"],
            ["GP20", "GP18", "GP17", "GP16"]
        ]
    },
    // Bottom-right key: hold it while plugging in to reach the bootloader.
    "bootmagic": {
        "matrix": [2, 3]
    },
    "ws2812": {
        // The ninex PCB drives the chain from GP19 (IC3 pad 30 -> NEOPIX,
        // through the 74HCT1G125 level shifter). GP16 is a switch here.
        "pin": "GP19",
        "driver": "vendor"
    },
    "rgb_matrix": {
        "driver": "ws2812",
        "max_brightness": 160,
        "sleep": true,
        // Written to EEPROM only when it is initialised (first plug-in, or
        // after an EEPROM reset), so anything set from Vial later persists and
        // wins from then on.
        "default": {
            "on": true,
            "animation": "cycle_left_right",
            "hue": 0,
            "sat": 255,
            "val": 160,
            "speed": 64
        },
        "animations": {
            "alphas_mods": true,
            "gradient_up_down": true,
            "gradient_left_right": true,
            "breathing": true,
            "band_sat": true,
            "band_val": true,
            "band_pinwheel_sat": true,
            "band_pinwheel_val": true,
            "band_spiral_sat": true,
            "band_spiral_val": true,
            "cycle_all": true,
            "cycle_left_right": true,
            "cycle_up_down": true,
            "rainbow_moving_chevron": true,
            "cycle_out_in": true,
            "cycle_out_in_dual": true,
            "cycle_pinwheel": true,
            "cycle_spiral": true,
            "dual_beacon": true,
            "rainbow_beacon": true,
            "rainbow_pinwheels": true,
            "raindrops": true,
            "jellybean_raindrops": true,
            "hue_breathing": true,
            "hue_pendulum": true,
            "hue_wave": true,
            "pixel_rain": true,
            "pixel_flow": true,
            "pixel_fractal": true,
            "typing_heatmap": true,
            "digital_rain": true,
            "solid_reactive_simple": true,
            "solid_reactive": true,
            "solid_reactive_wide": true,
            "solid_reactive_multiwide": true,
            "solid_reactive_cross": true,
            "solid_reactive_multicross": true,
            "solid_reactive_nexus": true,
            "solid_reactive_multinexus": true,
            "splash": true,
            "multisplash": true,
            "solid_splash": true,
            "solid_multisplash": true
        },
        // LED1..LED12 in chain order: top row left-to-right, middle row
        // right-to-left, bottom row left-to-right.
        "layout": [
            {"matrix": [0, 0], "x": 0,   "y": 0,  "flags": 4},
            {"matrix": [0, 1], "x": 68,  "y": 0,  "flags": 4},
            {"matrix": [0, 2], "x": 137, "y": 0,  "flags": 4},
            {"matrix": [0, 3], "x": 224, "y": 0,  "flags": 4},

            {"matrix": [1, 3], "x": 224, "y": 32, "flags": 4},
            {"matrix": [1, 2], "x": 137, "y": 32, "flags": 4},
            {"matrix": [1, 1], "x": 68,  "y": 32, "flags": 4},
            {"matrix": [1, 0], "x": 0,   "y": 32, "flags": 4},

            {"matrix": [2, 0], "x": 0,   "y": 64, "flags": 4},
            {"matrix": [2, 1], "x": 68,  "y": 64, "flags": 4},
            {"matrix": [2, 2], "x": 137, "y": 64, "flags": 4},
            {"matrix": [2, 3], "x": 224, "y": 64, "flags": 4}
        ]
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},
                {"matrix": [0, 3], "x": 3.28, "y": 0},

                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},
                {"matrix": [1, 2], "x": 2, "y": 1},
                {"matrix": [1, 3], "x": 3.28, "y": 1},

                {"matrix": [2, 0], "x": 0, "y": 2},
                {"matrix": [2, 1], "x": 1, "y": 2},
                {"matrix": [2, 2], "x": 2, "y": 2},
                {"matrix": [2, 3], "x": 3.28, "y": 2}
            ]
        }
    }
}
